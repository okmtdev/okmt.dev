---
/* 案2: 付録。手掛けてきたものと研究・論文を、ページ末尾に畳んでおく。 */
import { getCollection } from 'astro:content';
import { publications } from '../data/publications';
import Products from './Products.astro';
import Research from './Research.astro';
const nProducts = (await getCollection('products')).length;
const nPubs = publications.length;
const rows = [
  { id: 'ap-products', ja: '手掛けてきたもの', en: 'Shipped', n: nProducts },
  { id: 'ap-research', ja: '研究と論文', en: 'Research', n: nPubs },
];
---
<section class="section appendix" aria-labelledby="appendix">
  <div class="container">
    <div class="head">
      <h2 id="appendix" class="label">付録 / Appendix</h2>
      <p class="note">資料編。手掛けたものと、学生時代の研究。<span class="en-text">Reference material: products shipped, and research from graduate school.</span></p>
    </div>
    <div class="rows">
      {rows.map((r) => (
        <button type="button" class="row" aria-expanded="false" aria-controls={r.id} data-target={r.id}>
          <span class="pm" aria-hidden="true">+</span>
          <span class="ja">{r.ja}</span>
          <span class="en">{r.en} · {r.n}</span>
        </button>
      ))}
    </div>
  </div>
  <div id="ap-products" class="panel" hidden><Products /></div>
  <div id="ap-research" class="panel" hidden><Research /></div>
</section>

<style>
  .appendix { padding-bottom: 0; }
  .head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 24px; margin-bottom: 20px; }
  .head h2 { margin: 0; font-weight: 400; }
  .note { margin: 0; font-size: 14px; color: var(--ink-2); display: flex; flex-direction: column; gap: 2px; }
  .rows { border-top: 1px solid var(--rule); }
  .row {
    display: flex; align-items: baseline; gap: 14px; width: 100%; padding: 18px 0; margin: 0;
    background: none; border: 0; border-bottom: 1px solid var(--rule); font: inherit; color: var(--ink); cursor: pointer; text-align: left;
  }
  .row:hover { background: var(--ai-soft); }
  .row:focus-visible { outline: 2px solid var(--ai); outline-offset: 2px; }
  .pm { font-family: var(--mono); color: var(--ai); width: 1em; }
  .row[aria-expanded="true"] .pm::before { content: "−"; }
  .row[aria-expanded="true"] .pm { font-size: 0; }
  .row[aria-expanded="true"] .pm::before { font-size: 16px; }
  .ja { font-family: var(--serif); font-weight: 600; font-size: 18px; letter-spacing: 0.06em; }
  .en { font-family: var(--mono); font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--mute); }
  .panel[hidden] { display: none; }
  .panel { margin-top: clamp(40px, 6vw, 72px); }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.appendix .row').forEach((btn) => {
    const panel = document.getElementById(btn.dataset.target!);
    if (!panel) return;
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') !== 'true';
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      panel.hidden = !open;
      if (open) panel.scrollIntoView({ block: 'start', behavior: 'smooth' });
    });
  });
</script>
