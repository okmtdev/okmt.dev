---
/* 技: プロダクトの 4 階層 Core / Why / What / How を、RevComm と建設系スタートアップ（副業）の 2 軸で。
   その下にフロントエンド / バックエンド / インフラ・クラウドの土台。ホバーでその軸（または土台）だけが残る。 */
type Col = 'rc' | 'sb';
type Pill = { id: string; col: Col; x: number; y: number; w: number; h: number; label: string; xs?: boolean; cap: string };
const RC = 217, SB = 472; // 各軸の中心 x
const caps = {
  core: 'Core の層。事業戦略 / Mission / Vision。会話を資産に変える。すべての判断はここに遡る。',
  why: 'Why の層。誰を、どんな状態にしたいか。Executive には事業判断の材料を、Sales にはセルフコーチングを、Manager にはチーム全体の把握を。',
  what: 'What の層。Why を満たすために何を作るか。UX 改善、ロードマップ定義、カスタマージャーニー。',
  how: 'How の層。どう実現するか。MiiTel Phone / Analytics / API（β）、Salesforce・HubSpot・kintone との連携、外部連携。',
  sbCore: '副業の Core。AI で建設業界に変革を。',
  sbWhy: '副業の Why。事故の無い工事現場に。',
  sbWhat: '副業の What。現場の人のメンタルモデルを捉え、それに合わせて設計する。',
  sbHow: '副業の How。安全管理 SaaS と、交通量カウントのクラウド版。',
};
const row = (col: Col, layer: string, y: number, h: number, items: [string, number][], cap: string, xs = false, gap = 6): Pill[] => {
  const total = items.reduce((a, [, w]) => a + w, 0) + gap * (items.length - 1);
  let x = (col === 'rc' ? RC : SB) - total / 2;
  return items.map(([label, w], i) => { const p = { id: `${col}-${layer}-${i}`, col, x, y, w, h, label, xs, cap }; x += w + gap; return p; });
};
const pills: Pill[] = [
  ...row('rc', 'core', 28, 30, [['会話を資産に', 150]], caps.core),
  ...row('rc', 'why', 80, 22, [['Executive が事業判断の材料に', 210]], caps.why),
  ...row('rc', 'why2', 106, 22, [['Sales がセルフコーチング', 210]], caps.why),
  ...row('rc', 'why3', 132, 22, [['Manager がチーム全体を把握', 210]], caps.why),
  ...row('rc', 'what', 174, 30, [['UX 改善', 68], ['ロードマップ定義', 108], ['カスタマージャーニー', 130]], caps.what),
  ...row('rc', 'how', 226, 30, [['MiiTel Phone', 92], ['MiiTel Analytics', 112], ['MiiTel API（β）', 100]], caps.how),
  ...row('rc', 'how2', 262, 30, [['Salesforce 連携', 104], ['HubSpot 連携', 96], ['kintone 連携', 92]], caps.how),
  ...row('rc', 'how3', 298, 30, [['外部連携', 80]], caps.how),
  ...row('sb', 'core', 28, 30, [['AI で業界に変革を', 150]], caps.sbCore),
  ...row('sb', 'why', 106, 22, [['事故の無い工事現場に', 150]], caps.sbWhy, true),
  ...row('sb', 'what', 174, 30, [['メンタルモデル', 150]], caps.sbWhat, true),
  ...row('sb', 'how', 226, 30, [['安全管理 SaaS', 150]], caps.sbHow, true),
  ...row('sb', 'how2', 262, 30, [['交通量カウント クラウド版', 150]], caps.sbHow, true),
];
// 軸ごとの縦の連結線（層と層の間）と、土台への線
const edges = [
  { id: 'e-rc-1', col: 'rc', d: `M${RC} 58 V80` }, { id: 'e-rc-2', col: 'rc', d: `M${RC} 154 V174` }, { id: 'e-rc-3', col: 'rc', d: `M${RC} 204 V226` }, { id: 'e-rc-4', col: 'rc', d: `M${RC} 328 V346` },
  { id: 'e-sb-1', col: 'sb', d: `M${SB} 58 V106` }, { id: 'e-sb-2', col: 'sb', d: `M${SB} 128 V174` }, { id: 'e-sb-3', col: 'sb', d: `M${SB} 204 V226` }, { id: 'e-sb-4', col: 'sb', d: `M${SB} 292 V346` },
];
// 土台 3 層。上から フロントエンド / バックエンド / インフラ・クラウド
const base = [
  { id: 'fnd-fe', y: 346, h: 26, k: 'Frontend', lines: ['React · TypeScript · JavaScript · Flutter'], cap: '土台の最上層、フロントエンド。React / TypeScript / JavaScript / Flutter。' },
  { id: 'fnd-be', y: 376, h: 26, k: 'Backend', lines: ['Python · Go · Java · Ruby · Linux'], cap: '土台の中層、バックエンド。Python / Go / Java / Ruby、そして Linux。' },
  { id: 'fnd-inf', y: 406, h: 56, k: 'Infra', lines: [
    'AWS · EKS, ECS, S3, RDS, DynamoDB, CloudFront, Amplify, Lambda, Bedrock, …',
    'GCP · GKE, App Engine, Cloud Storage, Cloud SQL, BigQuery, Cloud Functions, …',
    'Azure · VM, SQL Server, Azure Functions, Entra ID, …   ·   Terraform',
  ], cap: '土台の最下層、インフラとクラウド。AWS / GCP / Azure を Terraform で。ここを自分で書いていたから、上の層の判断に根拠が持てる。' },
];
const baseIds = base.map((b) => b.id).join(' ');
const links = (col: Col) => [...pills.filter((p) => p.col === col).map((p) => p.id), ...edges.filter((e) => e.col === col).map((e) => e.id), baseIds].join(' ');
const baseLinks = [baseIds, 'e-rc-4', 'e-sb-4'].join(' ');
---
<figure class="ifig" data-ifig>
  <svg viewBox="0 0 560 470" role="img" aria-label="プロダクトの4階層（Core / Why / What / How）を RevComm と建設系スタートアップの2軸で示し、その下にフロントエンド・バックエンド・インフラの土台を置いた図">
    <text x={RC} y="14" text-anchor="middle" class="lbl">RevComm</text>
    <text x={SB} y="14" text-anchor="middle" class="lbl tight">建設系スタートアップ（副業）</text>
    <text x="8" y="47" class="lbl">Core</text>
    <text x="8" y="121" class="lbl">Why</text>
    <text x="8" y="193" class="lbl">What</text>
    <text x="8" y="281" class="lbl">How</text>
    <line x1="14" y1="54" x2="14" y2="328" class="axis" />
    <line x1="384" y1="22" x2="384" y2="328" class="axis" />

    {edges.map((e) => <g class="d edge" data-id={e.id}><path d={e.d} /></g>)}
    {pills.map((p) => (
      <g class="d hit" data-id={p.id} data-links={links(p.col)} data-cap={p.cap} role="button" aria-label={p.label}>
        <rect class={`node ${p.id.includes('-core-') ? 'core' : p.id.includes('-why') ? 'why' : p.id.includes('-how') ? 'how' : ''}`} x={p.x} y={p.y} width={p.w} height={p.h} rx={p.h / 2 > 12 ? 2 : p.h / 2} />
        <text x={p.x + p.w / 2} y={p.y + p.h / 2 + 4} text-anchor="middle" class={`t ${p.xs ? 'xs' : ''}`}>{p.label}</text>
      </g>
    ))}
    {base.map((b) => (
      <g class="d hit" data-id={b.id} data-links={baseLinks} data-cap={b.cap} role="button" aria-label={b.k}>
        <rect class="node base" x="40" y={b.y} width="512" height={b.h} rx="2" />
        <text x="50" y={b.y + 17} class="lbl">{b.k}</text>
        {b.lines.map((l, i) => <text x="136" y={b.y + 17 + i * 15} class="t sm base-t">{l}</text>)}
      </g>
    ))}
  </svg>
  <figcaption>
    <span class="cap"></span>
  </figcaption>
</figure>

<style>
  .axis { stroke: var(--rule); stroke-width: 1; }
  .lbl.tight { letter-spacing: .06em; }
  .node.core { fill: var(--ai); stroke: var(--ai); }
  .node.core + .t { fill: var(--paper); }
  .node.why { stroke-dasharray: 3 3; }
  .node.how { fill: var(--ai-soft); }
  .node.base { fill: var(--paper-2); }
  .t.xs { font-size: 10px; }
  .t.base-t { font-size: 9.5px; }
  .ifig.hov .on .node.why { stroke-dasharray: none; }
</style>
