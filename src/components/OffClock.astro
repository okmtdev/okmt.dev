---
import SectionHead from './SectionHead.astro';
import { profile } from '../data/profile';
const photo = profile.dogPhotos[1];
const items = [
  { t: '犬と暮らす', ja: '妻と犬と暮らしています。犬に服着せるな。', en: 'Living with my wife and our dog. Do not dress the dog.' },
  { t: 'プレミアリーグ', ja: 'イギリスのスタジアムに足を運び、現地の空気を浴びています。', en: 'Once a year I fly to England to watch a match in the stadium.' },
  { t: 'ディカプリオの映画', ja: '『Catch Me If You Can』『The Wolf of Wall Street』など。', en: 'Catch Me If You Can, The Wolf of Wall Street, and the rest.' },
  { t: '食べること・飲むこと', ja: 'おいしいものと、それに合う一杯。', en: 'Good food, and the right drink to go with it.' },
];
// 「追加で表示する」を押しても項目は増えない。続きは直接話しましょう、という誘い
const talk = { ja: 'その他の話は、ぜひ直接お話ししましょう。', en: 'For the rest, let us talk in person. Reach me through the links below.' };
---
<section class="section" aria-labelledby="off">
  <div class="container grid">
    <div>
      <SectionHead ja="プライベート" en="Private" id="off" />
      <ul class="items" id="off-items">
        {items.map((it) => (
          <li>
            <h3>{it.t}</h3>
            <p>{it.ja}</p>
            <p class="en-text">{it.en}</p>
          </li>
        ))}
        <li class="talk" id="off-talk" hidden>
          <h3>その他</h3>
          <p>{talk.ja}</p>
          <p class="en-text">{talk.en}</p>
        </li>
      </ul>
      <button type="button" class="expand" id="off-more" aria-expanded="false" aria-controls="off-items">
        <span class="open">+ 追加で表示する <span class="en-text">Show more</span></span>
        <span class="close">− 閉じる <span class="en-text">Show less</span></span>
      </button>
    </div>
    {photo && (
      <figure class="pop dogfig" id="dogpop" tabindex="0" role="button" aria-label="愛犬の写真。触れると飛んでいって、上の写真と入れ替わります">
        <div class="card">
          <img src={photo.src} alt={photo.alt} width="640" height="640" loading="lazy" />
        </div>
        <div class="paws" aria-hidden="true">
          {[['10%','-10%','-18deg','.05s'],['34%','-26%','12deg','.2s'],['56%','-44%','-6deg','.35s'],['74%','-64%','20deg','.5s'],['88%','-86%','-12deg','.65s'],['-6%','30%','35deg','.15s'],['98%','50%','-30deg','.3s'],['40%','96%','8deg','.1s']].map(([l,t,r,d], i) => (
            <svg class={`paw ${i % 2 ? 'pink' : ''}`} style={`left:${l};top:${t};--r:${r};--d:${d}`}><use href="#paw" /></svg>
          ))}
          {[['-6%','-4%','.1s'],['104%','10%','.35s'],['50%','-20%','.55s'],['96%','96%','.2s'],['-2%','92%','.45s'],['70%','-40%','.7s']].map(([l,t,d], i) => (
            <svg class={`spark ${i % 2 ? 'blue' : ''}`} style={`left:${l};top:${t};--d:${d}`}><use href="#spark" /></svg>
          ))}
        </div>
        <figcaption class="en-text"><span class="cap-text">{photo.caption}</span></figcaption>
      </figure>
    )}
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: clamp(32px, 6vw, 80px); align-items: start; }
  .items { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 28px; }
  .items li { border-top: 1px solid var(--rule); padding-top: 12px; }
  h3 { margin: 0 0 6px; font-family: var(--serif); font-weight: 600; font-size: 18px; letter-spacing: 0.06em; }
  .items p { font-size: 14px; }
  .talk { grid-column: 1 / -1; border-top-color: var(--ai); }
  .talk[hidden] { display: none; }
  .talk h3 { color: var(--ai); }
  .expand {
    display: flex; gap: 10px; align-items: baseline; width: 100%; margin: 24px 0 0; padding: 14px 0;
    border: 0; border-top: 1px solid var(--rule); background: none;
    font: inherit; font-size: 14px; color: var(--ai); cursor: pointer; text-align: left;
  }
  .expand:hover { background: var(--ai-soft); }
  .expand:focus-visible { outline: 2px solid var(--ai); outline-offset: 2px; }
  .expand .en-text { margin-left: 6px; }
  .expand .close { display: none; }
  .expand[aria-expanded="true"] .open { display: none; }
  .expand[aria-expanded="true"] .close { display: inline; }

  /* Dog photo: hover sends it spinning off toward the Profile photo, and the two trade places (shared styles in global.css). */
  .pop { margin: 0; padding-top: 14px; z-index: 1; outline: none; }
  .pop:focus-visible .card { outline: 2px solid var(--ai); outline-offset: 4px; }
  .card { position: relative; aspect-ratio: 1 / 1; border-radius: 2px; overflow: hidden; background: var(--paper-2); box-shadow: 0 0 0 6px var(--paper), 0 18px 40px -22px rgba(0,0,0,.35); }
  .card img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .6s ease; }
  .pop:hover .card img { transform: scale(1.04); }
  .pop figcaption { margin-top: 12px; }
  @media (max-width: 760px) {
    .grid { grid-template-columns: 1fr; }
    .items { grid-template-columns: 1fr; }
    .pop { max-width: 360px; }
  }
</style>

<script>
  const more = document.getElementById('off-more');
  const talk = document.getElementById('off-talk');
  if (more && talk) {
    more.addEventListener('click', () => {
      const open = more.getAttribute('aria-expanded') !== 'true';
      more.setAttribute('aria-expanded', open ? 'true' : 'false');
      talk.hidden = !open;
    });
  }

  const figs = [document.getElementById('dogpop'), document.getElementById('dog-main')].filter(Boolean) as HTMLElement[];
  if (figs.length === 2) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let busy = false;
    const swap = () => {
      const [a, b] = figs.map((f) => ({ img: f.querySelector('img')!, cap: f.querySelector<HTMLElement>('.cap-text')! }));
      [a.img.src, b.img.src] = [b.img.src, a.img.src];
      [a.img.alt, b.img.alt] = [b.img.alt, a.img.alt];
      [a.cap.textContent, b.cap.textContent] = [b.cap.textContent, a.cap.textContent];
    };
    const replay = (el: HTMLElement, ...cls: string[]) => { el.classList.remove('playing'); void el.offsetWidth; el.classList.add('playing', ...cls); };
    const go = (from: HTMLElement) => {
      if (busy) return;
      busy = true;
      const other = figs.find((f) => f !== from)!;
      if (reduce) { swap(); busy = false; return; }
      replay(from, 'fly');
      setTimeout(() => {
        swap();
        from.classList.remove('fly');
        replay(from, 'land');
        replay(other, 'arrive');
        setTimeout(() => {
          from.classList.remove('land', 'playing');
          other.classList.remove('arrive', 'playing');
          busy = false;
        }, 1100);
      }, 1050);
    };
    figs.forEach((f) => {
      f.addEventListener('mouseenter', () => go(f));
      f.addEventListener('click', () => go(f));
      f.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); go(f); } });
    });
  }
</script>
